    "id": "lab-dark-gate",
    "type": "function",
    "z": "lab-dark-tab",
    "name": "Validar e impedir duplicidade",
    "func": "const job=msg.payload;\nif (!job || typeof job.id !== 'string' || !/^[a-z0-9-]{3,64}$/.test(job.id)) {node.error('ID inválido',msg);return null;}\nconst jobs=flow.get('jobs') || {};\nif (Object.prototype.hasOwnProperty.call(jobs,job.id)) {return [null,{payload:{id:job.id,resultado:'duplicado ignorado'}}];}\njobs[job.id]={id:job.id,titulo:String(job.titulo||''),estado:'pendente_revisao',aprovado:false};\nflow.set('jobs',jobs);\nmsg.payload=jobs[job.id];\nreturn [msg,null];",
    "outputs": 2,
    "noerr": 0,
    "initialize": "",
    "finalize": "",

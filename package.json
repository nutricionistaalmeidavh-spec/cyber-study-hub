{
  "name": "cyber-study-hub",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check:baseline": "node scripts/check-baseline.mjs",
    "validate:curriculum": "node scripts/validate-curriculum.mjs",
    "test:curriculum-validator": "node scripts/test-curriculum-validator.mjs",
    "verify:curriculum": "npm run check:baseline && npm run test:curriculum-validator && npm run validate:curriculum",
    "build": "npm run verify:curriculum && npm run verify:learning && npm run verify:catalog && npm run verify:quality && tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "verify:learning": "node scripts/verify-phase-08-11.mjs",
    "verify:catalog": "node scripts/verify-phase-12-14.mjs",
    "test:quality": "node scripts/test-quality-p0.mjs",
    "verify:quality": "node scripts/quality-p0.mjs && npm run test:quality && npm run test:pilot-grade-a && npm run test:a-002-008 && npm run test:grade-a-10-20",
    "report:quality": "node scripts/quality-p0.mjs --write",
    "test:pilot-grade-a": "node scripts/test-pilot-grade-a.mjs",
    "test:a-002-008": "node scripts/test-a-002-008-structure.mjs && node scripts/test-a-002-008.mjs",
    "test:a-10-20": "node scripts/test-lessons-10-20.mjs && node --test public/course-labs/a10-20/lab.test.mjs",
    "test:grade-a-10-20": "node scripts/test-grade-a-10-20.mjs"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "wrangler": "^4.33.1"
  }
}

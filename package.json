{
  "name": "cyber-study-hub",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check:baseline": "node scripts/check-baseline.mjs",
    "validate:curriculum": "node scripts/validate-curriculum.mjs",
    "test:curriculum-validator": "node scripts/test-curriculum-validator.mjs",
    "verify:curriculum": "npm run check:baseline && npm run test:curriculum-validator && npm run validate:curriculum",
    "build": "npm run verify:curriculum && npm run verify:ai-dev && npm run verify:learning && npm run verify:catalog && npm run verify:quality && tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "verify:learning": "node scripts/verify-phase-08-11.mjs",
    "verify:catalog": "node scripts/verify-phase-12-14.mjs",
    "test:quality": "node scripts/test-quality-p0.mjs",
    "verify:quality": "node scripts/quality-p0.mjs && npm run test:quality && npm run test:pilot-grade-a && npm run test:a-002-008 && npm run test:grade-a-10-20 && npm run test:a-021-030 && npm run test:grade-a-031-040 && npm run test:grade-a-41-50 && npm run test:grade-a-061-070 && npm run test:grade-a-071-080 && npm run test:grade-a-81-90 && npm run test:a-51-60 && npm run test:grade-a-51-60 && npm run test:grade-a-continuity && npm run test:grade-a-111-120 && npm run test:grade-a-121-130 && npm run test:a-91-100 && npm run test:grade-a-91-100 && npm run test:grade-a-101-110 && npm run test:a-151-159 && npm run test:grade-a-151-160 && npm run test:grade-a-161-170 && npm run test:grade-a-131-140",
    "report:quality": "node scripts/quality-p0.mjs --write",
    "test:pilot-grade-a": "node scripts/test-pilot-grade-a.mjs",
    "test:a-002-008": "node scripts/test-a-002-008-structure.mjs && node scripts/test-a-002-008.mjs",
    "test:a-10-20": "node scripts/test-lessons-10-20.mjs && node --test public/course-labs/a10-20/lab.test.mjs",
    "test:grade-a-10-20": "node scripts/test-grade-a-10-20.mjs",
    "test:a-021-030": "node scripts/test-a-021-030.mjs",
    "test:a-031-040": "node scripts/test-a-031-040-structure.mjs && node --test public/course-labs/a031-040/lab.test.mjs",
    "test:grade-a-031-040": "node scripts/test-grade-a-031-040.mjs",
    "test:a-41-50": "node scripts/test-lessons-41-50.mjs && node --test public/course-labs/a41-50/lab.test.mjs",
    "test:grade-a-41-50": "node scripts/test-grade-a-41-50.mjs",
    "test:a-061-070": "node scripts/test-a-061-070-structure.mjs && node --test public/course-labs/a061-070/lab.test.mjs",
    "test:grade-a-061-070": "node scripts/test-grade-a-061-070.mjs",
    "test:a-071-080": "node scripts/test-a-071-080-structure.mjs && node --test public/course-labs/a071-080/lab.test.mjs",
    "test:grade-a-071-080": "node scripts/test-grade-a-071-080.mjs",
    "test:a-81-90": "node scripts/test-lessons-81-90.mjs && node --test public/course-labs/a81-90/lab.test.mjs",
    "test:grade-a-81-90": "node scripts/test-grade-a-81-90.mjs",
    "test:a-51-60": "node --test public/course-labs/a051-060/labs.test.mjs",
    "test:grade-a-51-60": "node scripts/test-grade-a-51-60.mjs",
    "test:grade-a-continuity": "node scripts/test-grade-a-continuity.mjs",
    "test:a-111-120": "node scripts/test-a-111-120-structure.mjs && node --test public/course-labs/a111-120/lab.test.mjs",
    "test:grade-a-111-120": "node scripts/test-grade-a-111-120.mjs",
    "test:a-121-130": "node scripts/test-a-121-130-structure.mjs && node --test public/course-labs/a121-130/labs.test.mjs",
    "test:grade-a-121-130": "node scripts/test-grade-a-121-130.mjs",
    "test:a-91-100": "node --test public/course-labs/a91-100/lab.test.mjs",
    "test:grade-a-91-100": "node scripts/test-grade-a-91-100.mjs",
    "test:grade-a-101-110": "node scripts/test-grade-a-101-110.mjs",
    "start": "node server/start.mjs",
    "dev:api": "node server/start.mjs",
    "test:platform": "node --test server/*.test.mjs",
    "dev:worker": "wrangler dev --local",
    "test:worker": "node scripts/test-cloudflare.mjs",
    "test:a-151-159": "node --test public/course-labs/a151-159/lab.test.mjs",
    "test:grade-a-151-160": "node scripts/test-grade-a-151-160.mjs",
    "test:a-161-170": "node scripts/test-a-161-170-structure.mjs && node --test public/course-labs/a161-170/lab.test.mjs",
    "test:grade-a-161-170": "node scripts/test-grade-a-161-170.mjs",
    "test:a-131-140": "node scripts/test-a-131-140-structure.mjs && node --test public/course-labs/a131-140/labs.test.mjs",
    "test:grade-a-131-140": "node scripts/test-grade-a-131-140.mjs",
    "prebuild": "node scripts/check-cloudflare-worker.mjs",
    "test:kdf": "node --test scripts/test-password-kdf.mjs",
    "verify:ai-dev": "node scripts/verify-ai-dev.mjs"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "wrangler": "^4.33.1"
  }
}
